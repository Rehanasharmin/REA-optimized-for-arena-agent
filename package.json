{
  "name": "rea-agents",
  "mcpName": "io.github.morluto/rea",
  "version": "6.8.0",
  "description": "Reverse engineer anything from your terminal or agent with one CLI and MCP server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morluto/rea.git"
  },
  "homepage": "https://github.com/morluto/rea#readme",
  "bugs": {
    "url": "https://github.com/morluto/rea/issues"
  },
  "keywords": [
    "reverse-engineering",
    "binary-analysis",
    "agents",
    "agent-skills",
    "cli",
    "mcp-server",
    "model-context-protocol",
    "static-analysis",
    "rea",
    "decompiler",
    "mcp",
    "hopper",
    "electron",
    "javascript-analysis",
    "ghidra",
    "ida"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "imports": {
    "#javascript-analysis-worker": "./dist/composition/javascriptAnalysisWorkerProcess.js",
    "#web-bundle-analysis-worker": "./dist/composition/webBundleAnalysisWorkerProcess.js"
  },
  "bin": {
    "rea": "scripts/rea.mjs",
    "rea-agents": "scripts/rea.mjs"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "packageManager": "npm@11.16.0",
  "files": [
    "dist",
    "install.sh",
    "bridge/hopper_bridge.py",
    "bridge/cutter/rea_bridge.py",
    "bridge/native/NativeUIChildren.swift",
    "bridge/native/NativeUIValues.swift",
    "bridge/native/ReaNativeUI.swift",
    "bridge/native/rea_lldb_tracer.py",
    "bridge/process/ProcessRunTokenReader.swift",
    "bridge/process/ProcessRunTokenReaderMain.swift",
    "bridge/ghidra/ReaGhidraBridge.java",
    "bridge/ghidra/ReaGhidraBundleActivator.java",
    "bridge/ghidra/ReaGhidraExtensions.java",
    "bridge/ghidra/ReaGhidraPrepareCom.java",
    "bridge/ghidra/ReaGhidraApplySeeds.java",
    "bridge/ghidra/ReaGhidraAnalysisOptions.java",
    "bridge/ghidra/ReaGhidraNoReturnFix.java",
    "bridge/ghidra/ReaGhidraMipsSoftFloat.java",
    "bridge/ghidra/ReaGhidraRiscvCallingConvention.java",
    "bridge/ghidra/ReaGhidraPrepareRaw.java",
    "bridge/ghidra/ReaGhidraPrepareDol.java",
    "bridge/android/ReaJadxBridge.java",
    "bridge/mitmproxy/capture.py",
    "scripts/rea.mjs",
    "scripts/lib/cli-process-environment.mjs",
    "scripts/rea-android-workspace-guardian.mjs",
    "scripts/electron-active-hook.cjs",
    "scripts/electron-active-hook-boundaries.cjs",
    "scripts/hopper-demo-x11.py",
    "scripts/prepack.mjs",
    "scripts/prepare.mjs",
    "skills",
    "README.md",
    "DISCLAIMER.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "native/windows/build/manifest.json",
    "native/windows/build/rea-windows-x64.node",
    "scripts/verify-windows-native-artifact.mjs",
    "bridge/pwntools/layout.py",
    "bridge/pwntools/layout_impl.py",
    "third_party/pwntools/README.md",
    "third_party/wabt/README.md",
    "third_party/evmole/README.md",
    "third_party/evmole/LICENSE",
    "bridge/pwntools/decoder_runtime.py",
    "bridge/pwntools/recorded_crash.py",
    "bridge/pwntools/recorded_crash_impl.py",
    "bridge/pwndbg/launch.py",
    "bridge/pwndbg/launch_impl.py",
    "bridge/pwndbg/core_context.py",
    "third_party/pwndbg/README.md",
    "third_party/pwndbg/LICENSE.md",
    "licenses",
    "assets/rea-plugin.png",
    ".claude-plugin/plugin.json",
    ".codex-plugin/plugin.json",
    ".codex-plugin/mcp.json",
    "scripts/plugin-mcp-launcher.mjs",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "deps:check": "node scripts/check-dependency-install.mjs",
    "metadata:generate": "node scripts/run-exclusive.mjs artifacts node scripts/generate-package-metadata.mjs",
    "metadata:check": "node scripts/generate-package-metadata.mjs --check",
    "prebuild": "npm run deps:check",
    "build": "node scripts/run-exclusive.mjs artifacts node scripts/run-turbo.mjs run artifacts:skills --force",
    "build:cached": "node scripts/check-dependency-install.mjs && node scripts/run-exclusive.mjs artifacts node scripts/run-turbo.mjs run artifacts:skills",
    "build:termux": "node scripts/run-exclusive.mjs artifacts npm run build:termux:run",
    "build:termux:run": "npm run compile:termux && npm run artifacts:skills",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "start": "node scripts/rea.mjs mcp",
    "sandbox:provision": "bash scripts/sandbox/provision-sandbox.sh",
    "sandbox:verify": "node scripts/sandbox/verify-sandbox.mjs",
    "sandbox:check": "npm run typecheck && npm run verify:module-boundaries && npm run sandbox:verify",
    "typecheck": "node scripts/run-typescript.mjs --noEmit",
    "prepack": "node scripts/prepack.mjs",
    "verify:module-boundaries": "node scripts/verify-module-boundaries.mjs",
    "compile": "node scripts/clean-build-output.mjs && node scripts/run-typescript.mjs -p tsconfig.build.json && node scripts/record-catalog-digests.mjs && node scripts/record-mcp-catalog.mjs && node scripts/bundle-runtime.mjs",
    "compile:termux": "node scripts/clean-build-output.mjs && node --max-old-space-size=3072 node_modules/typescript-termux/lib/tsc.js -p tsconfig.build.json && node scripts/record-catalog-digests.mjs && node scripts/record-mcp-catalog.mjs && node scripts/bundle-runtime.mjs",
    "artifacts:mcp-catalog": "node scripts/generate-mcp-tool-catalog.mjs",
    "artifacts:skills": "node scripts/generate-skill-metadata.mjs",
    "artifacts:product-catalog": "node scripts/generate-product-catalog.mjs",
    "artifacts:managed-evidence": "node scripts/generate-completion-ledger.mjs",
    "artifacts:error-schema": "node scripts/generate-error-schema.mjs",
    "sandbox:bootstrap": "bash scripts/sandbox/bootstrap.sh",
    "sandbox:slim": "bash scripts/sandbox/slim-repo.sh"
  },
  "lint-staged": {
    "*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@babel/parser": "8.0.4",
    "@babel/types": "8.0.4",
    "@bufbuild/protobuf": "2.16.0",
    "@clack/prompts": "1.7.0",
    "@electron/asar": "4.2.0",
    "@jridgewell/trace-mapping": "0.3.31",
    "@lydell/node-pty": "1.1.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@msgpack/msgpack": "3.1.3",
    "@xmldom/xmldom": "0.9.12",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@zip.js/zip.js": "2.15.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "3.0.0",
    "cborg": "6.1.3",
    "cross-spawn": "7.0.6",
    "diff": "9.0.0",
    "evmole": "0.9.3",
    "har-schema": "2.0.0",
    "ignore": "7.0.6",
    "incur": "0.6.1",
    "isomorphic-git": "1.38.7",
    "jsonc-parser": "3.3.1",
    "lossless-json": "4.3.1",
    "openpgp": "6.3.2",
    "parse5": "8.0.1",
    "pino": "10.4.0",
    "playwright-core": "1.64.1",
    "plist": "5.0.0",
    "saxes": "6.0.0",
    "semver": "7.8.5",
    "smol-toml": "1.9.0",
    "stream-chain": "4.2.6",
    "stream-json": "3.7.0",
    "tokenx": "1.3.0",
    "write-file-atomic": "7.0.0",
    "ws": "8.21.0",
    "yaml": "2.9.0",
    "zod": "4.6.6"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "6.16.1"
    },
    "vitepress": {
      "vite": "6.4.4"
    }
  },
  "devDependencies": {
    "@fast-check/vitest": "0.5.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@toon-format/toon": "2.3.1",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "26.6.4",
    "@types/semver": "7.7.1",
    "@types/write-file-atomic": "4.0.3",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "5.0.3",
    "husky": "9.1.7",
    "jscpd": "5.0.12",
    "knip": "6.39.0",
    "lint-staged": "16.4.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2005",
    "release-please": "17.3.0",
    "rolldown": "1.2.12",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsx": "4.23.15",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "typescript-termux": "npm:typescript@5.9.3",
    "typescript6": "npm:typescript@6.0.3",
    "vitepress": "1.6.4",
    "vitest": "5.0.3"
  },
  "optionalDependencies": {
    "frida": "17.23.2"
  },
  "allowScripts": {
    "frida@17.23.2": true
  }
}
